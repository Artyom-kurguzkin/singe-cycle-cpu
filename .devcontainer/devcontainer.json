{
  "name": "VHDL Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "mounts": [
    "source=${localWorkspaceFolder}/assets,target=/workspace/assets,type=bind,consistency=cached",
    "source=${localEnv:USERPROFILE}/.claude,target=/tmp/host-claude,type=bind,consistency=cached"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "rjyoung.vscode-modern-vhdl-support",
        "lramseyer.vaporview",
        "ms-vscode.makefile-tools"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "runArgs": ["--network=host", "--privileged"],
  "postStartCommand": "mkdir -p ~/.claude && cp /tmp/host-claude/.credentials.json ~/.claude/.credentials.json && chmod 600 ~/.claude/.credentials.json || true",
  "postCreateCommand": "echo 'Container ready. Simulation: make sim TB=<name> | FPGA: make fpga TOP=<entity> XDC=<file.xdc>'",
  "otherPortsAttributes": {
    "onAutoForward": "silent"
  }
}
